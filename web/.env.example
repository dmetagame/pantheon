# --- AI Gateway (Vercel) ---
AI_GATEWAY_API_KEY=
LLM_PRIMARY_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODEL=anthropic/claude-haiku-4-5

# --- Casper Testnet ---
CASPER_NETWORK=casper-test
CASPER_NODE_URL=https://node.testnet.cspr.cloud/rpc
# Optional: submit writes to a different RPC than reads/finalization polling.
# Useful when a public node is good for reads but rejects transaction payloads.
CASPER_SUBMIT_NODE_URL=
# Optional: comma/space separated submit failover list. When set, this
# supersedes CASPER_SUBMIT_NODE_URL. CSPR Cloud endpoints receive the
# CSPR_CLOUD_API_KEY Authorization header; public endpoints do not.
CASPER_SUBMIT_NODE_URLS=
# Optional: poll finalization from a different RPC to avoid exhausting the
# submit/read provider's rate limit.
CASPER_POLL_NODE_URL=
CSPR_CLOUD_API_KEY=

# Admin signing key. Use _PEM in prod (Vercel filesystem is read-only), or
# _PATH for local dev. Either env var works.
CASPER_ADMIN_SECRET_KEY_PATH=/absolute/path/to/admin_secret_key.pem
# CASPER_ADMIN_SECRET_KEY_PEM=
CASPER_ADMIN_PUBLIC_KEY=

# Deployed contract package hashes (32-byte hex, no 0x).
PROPHECY_REGISTRY_HASH=
REPUTATION_CONTRACT_HASH=
# Reputation contract VERSION hash for on-chain reputation cross-verify
# (changes on every redeploy). Optional — falls back to REPUTATION_CONTRACT_HASH.
REPUTATION_CONTRACT_VERSION_HASH=
# Keep as record_outcome for the current deployed Reputation hash. Set to
# record_prophecy_outcome after redeploying the idempotent Reputation contract.
REPUTATION_OUTCOME_ENTRYPOINT=record_outcome
PRIEST_QUORUM_HASH=

# Per-god public keys — used in x402 accepts envelope as payTo.
DEMETER_PUBLIC_KEY=
HERMES_PUBLIC_KEY=
APOLLO_PUBLIC_KEY=

# Pantheon priests — co-sign settlement quorum proposals. Per-god priest keys
# are preferred; PRIEST_PUBLIC_KEY is the legacy shared-priest fallback.
PRIEST_DEMETER_PUBLIC_KEY=
PRIEST_HERMES_PUBLIC_KEY=
PRIEST_APOLLO_PUBLIC_KEY=
PRIEST_PUBLIC_KEY=
# CASPER_PRIEST_DEMETER_SECRET_KEY_PEM=
# CASPER_PRIEST_HERMES_SECRET_KEY_PEM=
# CASPER_PRIEST_APOLLO_SECRET_KEY_PEM=
CASPER_PRIEST_DEMETER_SECRET_KEY_PATH=/absolute/path/to/priest-demeter.pem
CASPER_PRIEST_HERMES_SECRET_KEY_PATH=/absolute/path/to/priest-hermes.pem
CASPER_PRIEST_APOLLO_SECRET_KEY_PATH=/absolute/path/to/priest-apollo.pem
# CASPER_PRIEST_SECRET_KEY_PEM=
CASPER_PRIEST_SECRET_KEY_PATH=/absolute/path/to/priest.pem

# Petitioner — autonomous-agent demo customer. Signs x402 transfer
# authorizations when consulting gods. Separate keypair so cspr.live shows
# the agent as a distinct payer in the payment trail.
PETITIONER_PUBLIC_KEY=
# CASPER_PETITIONER_SECRET_KEY_PEM=
CASPER_PETITIONER_SECRET_KEY_PATH=/absolute/path/to/petitioner.pem

# --- Database ---
DATABASE_URL=

# --- Cron + demo auth ---
# Vercel cron auto-attaches `Authorization: Bearer ${CRON_SECRET}` to scheduled
# invocations. Generate with `openssl rand -hex 32`.
CRON_SECRET=
# Casper testnet finalization can exceed two minutes under load; settle cron
# uses this window only for the quorum proposal event lookup.
SETTLE_PROPOSAL_CONFIRM_TIMEOUT_MS=240000
# Bearer token the MCP server / demo clients pass to /api/consult/<god>.
# Replaced by real x402 verification once that rail is wired.
CONSULT_DEMO_SECRET=

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3030

# --- x402 (Casper Facilitator) ---
# Facilitator URL is shared between testnet and mainnet; X402_NETWORK picks
# which chain it settles on. Wrapped CSPR is the recommended x402 settlement
# asset — 9 decimals, wrap CSPR ↔ WCSPR 1:1 via testnet.cspr.trade.
X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
X402_NETWORK=casper:casper-test
X402_TOKEN_HASH=3d80df21ba4ee4d66a2a1f60c32570dd5685e4b279f6538162a5fd1314847c1e
X402_TOKEN_NAME=Wrapped CSPR
X402_TOKEN_VERSION=1
# 0.1 WCSPR per consult (10^8 motes at 9 decimals).
X402_CONSULT_AMOUNT=100000000
